{
  "name": "keycloak-tool-use",
  "description": "NL prompts aligned with evals/dataset.jsonl (same operation + requiredKeys). Realm-scoped examples use realm master where applicable.",
  "examples": [
    {
      "inputs": {
        "input": "List all realms accessible to the user"
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "GET_REALMS",
              "params": "{}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "GET_REALMS",
        "requiredKeys": []
      }
    },
    {
      "inputs": {
        "input": "Get details of a specific realm named master."
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "GET_REALM",
              "params": "{\"realmName\":\"master\"}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "GET_REALM",
        "requiredKeys": ["realmName"]
      }
    },
    {
      "inputs": {
        "input": "List all users in the master realm"
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "GET_USERS",
              "params": "{\"realm\":\"master\"}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "GET_USERS",
        "requiredKeys": ["realm"]
      }
    },
    {
      "inputs": {
        "input": "Count users in the master realm"
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "COUNT_USERS",
              "params": "{\"realm\":\"master\"}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "COUNT_USERS",
        "requiredKeys": ["realm"]
      }
    },
    {
      "inputs": {
        "input": "List all clients in the master realm"
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "GET_CLIENTS",
              "params": "{\"realm\":\"master\"}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "GET_CLIENTS",
        "requiredKeys": ["realm"]
      }
    },
    {
      "inputs": {
        "input": "In realm master, get a user by their username admin."
      },
      "expectedOutputs": {
        "toolCalls": [
          {
            "name": "invokeKeycloakOperation",
            "arguments": {
              "operation": "GET_USER_BY_USERNAME",
              "params": "{\"realm\":\"master\",\"username\":\"admin\"}"
            }
          }
        ]
      },
      "metadata": {
        "operation": "GET_USER_BY_USERNAME",
        "requiredKeys": ["realm", "username"]
      }
    }
  ]
}
